# syntax=docker/dockerfile:1
# ─── Stage 1: Builder ──────────────────────────────────────────────
FROM node:20-alpine AS builder

# Prisma 5.x requires libssl 1.1 (openssl-compat) on Alpine
RUN apk add --no-cache openssl openssl-dev libc6-compat

WORKDIR /app

COPY package*.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --prefer-offline

COPY . .

RUN npx prisma generate

# Provide a dummy DATABASE_URL so Next.js doesn't crash during static-page generation
ENV DATABASE_URL="mysql://build:build@localhost:3306/build"

RUN npm run build

# ─── Stage 2: Seeder (lightweight – only needs prisma + node) ───────
FROM node:20-alpine AS seeder

RUN apk add --no-cache openssl openssl-dev libc6-compat

WORKDIR /app

COPY package*.json ./
COPY prisma ./prisma

# Reuse node_modules from builder — no extra npm install needed
COPY --from=builder /app/node_modules ./node_modules

CMD ["sh", "-c", "npx prisma db push --accept-data-loss && npx prisma db seed"]

# ─── Stage 3: Runner (production Next.js) ───────────────────────────
FROM node:20-alpine AS runner

RUN apk add --no-cache openssl openssl-dev libc6-compat

WORKDIR /app
ENV NODE_ENV=production

COPY package*.json ./

# Reuse node_modules from builder — no extra npm install needed
COPY --from=builder /app/node_modules ./node_modules

COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/prisma ./prisma

EXPOSE 3000

CMD ["npm", "start"]